# PRODUCTION (AWS EC2, eu-north-1). You do NOT create this file by hand: deploy/aws/instance/hcf-update.sh writes
# /opt/hcf/.env on the server from SSM Parameter Store (/hcf/prod/*, SecureString). Listed here so the keys are documented.
ENVIRONMENT=production                # SECRET_KEY is mandatory in production (the API refuses to start without it)
SECRET_KEY=<ssm:/hcf/prod/SECRET_KEY>
POSTGRES_PASSWORD=<ssm:/hcf/prod/POSTGRES_PASSWORD>
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=<ssm:/hcf/prod/ADMIN_PASSWORD>
DEVICE_PASSWORD=<ssm:/hcf/prod/DEVICE_PASSWORD>
STREAM_USER=sim-device
CLOUD_ADAPTER=s3                      # CLOUD-path objects -> s3://hcf-app-<account>-eu-north-1/processed/
S3_BUCKET=hcf-app-<account>-eu-north-1
SNS_TOPIC_ARN=arn:aws:sns:eu-north-1:<account>:hcf-alerts
AWS_DEFAULT_REGION=eu-north-1         # credentials come from the instance role via IMDSv2, never from this file
ALERT_NOTIFY_SEVERITIES=CRITICAL
