# TEST / CI. pytest builds its own settings (tests/conftest.py); this file documents the values CI uses for PostgreSQL runs.
ENVIRONMENT=test
SECRET_KEY=ci-only-not-a-secret-0000000000000000000000000000
DATABASE_URL=postgresql+psycopg2://hcf:hcf@localhost:5432/hcf_test
PASSWORD_HASH_ITERATIONS=1000
CLOUD_ADAPTER=local
ALERTS_SYNC=true
