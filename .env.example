# =============================================================
#  Telemedicine Workload Offloader — Environment Configuration
#  COPY this file to .env and fill in your real values
#  NEVER commit .env to git (it's in .gitignore)
# =============================================================

# ── Application ───────────────────────────────────────────────
APP_NAME=Telemedicine Workload Offloader API
APP_VERSION=2.0.0
ENVIRONMENT=development
DEBUG=true
ALLOWED_HOSTS=*

# ── Database (PostgreSQL + TimescaleDB) ───────────────────────
# Local Docker:
DATABASE_URL=postgresql+asyncpg://telemedicine:telemedicine123@localhost:5432/telemedicine
# Neon.tech (replace with your Neon connection string):
# DATABASE_URL=postgresql+asyncpg://user:password@ep-xxxx.us-east-2.aws.neon.tech/telemedicine?ssl=require

DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Redis ─────────────────────────────────────────────────────
# Local Docker:
REDIS_URL=redis://localhost:6379
# Upstash (free hosted Redis):
# REDIS_URL=rediss://default:password@upstash-redis-url.upstash.io:6379

REDIS_CACHE_TTL=300
RATE_LIMIT_PER_MINUTE=100

# ── JWT Auth ──────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── MQTT Broker (Mosquitto) ───────────────────────────────────
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC=telemedicine/devices/#
MQTT_CLIENT_ID=telemedicine-consumer

# ── Telegram Bot Alerts ───────────────────────────────────────
# 1. Open Telegram, search @BotFather, send /newbot
# 2. Copy the token it gives you → TELEGRAM_BOT_TOKEN
# 3. Send a message to your bot, then go to:
#    https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#    and copy the chat.id → TELEGRAM_CHAT_ID
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Email Alerts (Gmail SMTP) ─────────────────────────────────
# 1. Go to Google Account → Security → 2-Step Verification → App Passwords
# 2. Create an App Password for "Mail"
# 3. Use that 16-character password here (NOT your Gmail password)
EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your.email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password-here
EMAIL_FROM=telemedicine@yourhospital.com

# ── RIPE Atlas (Real Network Data) ───────────────────────────
# 1. Register at https://atlas.ripe.net/accounts/register/
# 2. Create an API key at https://atlas.ripe.net/keys/
RIPE_API_KEY=

# ── MLflow ────────────────────────────────────────────────────
# Local Docker:
MLFLOW_TRACKING_URI=http://localhost:5000
# Remote:
# MLFLOW_TRACKING_URI=https://your-mlflow-server.com
MLFLOW_EXPERIMENT_NAME=TelemedicineLatencyForecaster

# ── HIPAA / Security ──────────────────────────────────────────
EMERGENCY_CRITICALITY_THRESHOLD=9.0
LATENCY_VETO_MS=300.0
BCRYPT_ROUNDS=12

# ── Prometheus ────────────────────────────────────────────────
METRICS_ENABLED=true
