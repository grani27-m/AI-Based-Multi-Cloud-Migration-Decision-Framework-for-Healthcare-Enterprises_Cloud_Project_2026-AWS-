# Copy to .env and fill in. .env is git-ignored - never commit it.
ENVIRONMENT=development
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database: SQLite by default (runtime/app.db). Docker Compose sets PostgreSQL automatically.
# DATABASE_URL=postgresql+psycopg2://hcf:<password>@localhost:5432/hcf
POSTGRES_PASSWORD=

# First administrator, created only when the users table is empty
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# Used by scripts/stream_events.py, scripts/load_test.py and the MQTT bridge (create the user first)
STREAM_USER=sim-device
DEVICE_PASSWORD=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=600

# Decision engine (defaults = values in the project report)
AHP_WEIGHT_SET=eigenvector
EMERGENCY_CRITICALITY_THRESHOLD=9.0
LATENCY_VETO_MS=300

# Execution: local stand-ins by default. CLOUD_ADAPTER=s3 needs S3_BUCKET + AWS credentials (pip install boto3).
CLOUD_ADAPTER=local
S3_BUCKET=

# Alerts (all optional). Severities that are pushed; others are only recorded.
ALERT_NOTIFY_SEVERITIES=CRITICAL
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
# Gmail: use an App Password, never the account password
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=
ALERT_WEBHOOK_URL=
SNS_TOPIC_ARN=

# RIPE Atlas: not needed for public measurements; optional key raises rate limits
RIPE_API_KEY=
