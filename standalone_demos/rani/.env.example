# Rani standalone package configuration. `python 00_setup_env.py` creates .env from this file with random secrets.
ENVIRONMENT=development
SECRET_KEY=
# Persistent local database (SQLite file). For PostgreSQL: postgresql+psycopg2://user:pass@host:5432/db (pip install psycopg2-binary)
DATABASE_URL=sqlite:///runtime/app.db
RUNTIME_DIR=runtime
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
DOCTOR_PASSWORD=
DEVICE_PASSWORD=
STREAM_USER=sim-device
API_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Alerts: by default ONLY the local mock channel is on -> alerts get status "mock_delivered" (nobody is notified).
ALERT_MOCK_FILE=runtime/mock_alerts.jsonl
# Real delivery (optional, never commit values): Telegram, SMTP (Gmail app password), generic webhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
ALERT_WEBHOOK_URL=
# Execution: local stand-ins (labelled). CLOUD_ADAPTER=s3 + S3_BUCKET uses real Amazon S3 (pip install boto3 + AWS credentials).
CLOUD_ADAPTER=local
S3_BUCKET=
