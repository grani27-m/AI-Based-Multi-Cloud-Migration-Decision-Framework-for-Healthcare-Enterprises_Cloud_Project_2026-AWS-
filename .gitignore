# Telemedicine Cloud Project — .gitignore
# ==========================================

# ── Python cache ──────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo

# ── Virtual environments ───────────────────────
.venv/
venv/
env/
ENV/
.env

# ── Trained model artifacts ────────────────────
src/prediction/model.h5
src/prediction/*.h5
src/prediction/*.keras

# ── Preprocessed / generated data ─────────────
data/raw/
data/processed/X_train.npy
data/processed/X_test.npy
data/processed/y_train.npy
data/processed/y_test.npy
data/processed/scaler.pkl
data/processed/app.db

# ── Result graphs (regenerated by train.py) ────
results/graphs/*.png
results/graphs/*.jpg

# ── Logs ──────────────────────────────────────
logs/system.log
logs/system.log.*

# ── Pytest & coverage ──────────────────────────
.pytest_cache/
.coverage
htmlcov/
*.xml

# ── IDE and OS files ──────────────────────────
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ── Streamlit ─────────────────────────────────
.streamlit/secrets.toml

# ── Jupyter ───────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Node / Frontend ───────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
dist/
.vite/
